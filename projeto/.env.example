# Copie para .env e ajuste. NUNCA versione o .env real.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=root_dev_123
MYSQL_PORT=3306

MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle
MOODLE_DB_PASSWORD=moodle_dev_123

CATALOGO_DB_NAME=catalogo
CATALOGO_DB_USER=catalogo
CATALOGO_DB_PASSWORD=catalogo_dev_123

# ---- Moodle ----
MOODLE_PORT=8080
MOODLE_SITE_NAME=CTED - Ambiente de testes
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=Admin@12345
MOODLE_ADMIN_EMAIL=admin@example.com
# Token de Web Service. Se vazio, a API tenta obter um via login/token.php
# usando MOODLE_ADMIN_USER/PASSWORD (apenas para ambiente local).
MOODLE_WS_TOKEN=

# ---- API / Front ----
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5000
# Use FRONTEND_PORT=80 para acessar o front em http://localhost/ (a porta precisa estar livre)
FRONTEND_PORT=3000
ADMINER_PORT=8081
MAILPIT_PORT=8025
